extends ../layout/index

block styles
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/dropzone.css")
    meta(name="csrf-token" content= csrfToken)
    style.
        .dropzone {
            border: 2px dashed #6B46C1 !important;
            border-radius: 0.5rem;
            min-height: 150px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }
        .dropzone:hover {
            background-color: #F9FAFB;
            border-color: #9F7AEA !important;
        }
        .dropzone .dz-message {
            text-align: center;
            margin: 0;
        }
        .dropzone .dz-preview {
            margin: 1rem;
        }

block contenido
    div(class="py-10")
        h1(class="text-4xl my-10 font-extrabold text-center")
            span(class="text-cute_purple-100") Bienes 
            span(class="font-normal text-black") Raíces
        h2(class="text-center text-2xl font-extrabold font-mono")= pagina

        if errores
            .fixed.top-4.right-4.z-50.flex.flex-col.gap-4#alertContainer
                each error, index in errores
                    .flex.w-96.shadow-lg.rounded-lg.animate-fade-in-right.transition-opacity.duration-150.ease-out(class="alert-item" data-alert-id=index)
                        .bg-cute_purple-100.py-4.px-6.rounded-l-lg.flex.items-center
                            svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" class="fill-current text-white" width="20" height="20")
                                path(fill-rule="evenodd" d="M8.22 1.754a.25.25 0 00-.44 0L1.698 13.132a.25.25 0 00.22.368h12.164a.25.25 0 00.22-.368L8.22 1.754zm-1.763-.707c.659-1.234 2.427-1.234 3.086 0l6.082 11.378A1.75 1.75 0 0114.082 15H1.918a1.75 1.75 0 01-1.543-2.575L6.457 1.047zM9 11a1 1 0 11-2 0 1 1 0 012 0zm-.25-5.25a.75.75 0 00-1.5 0v2.5a.75.75 0 001.5 0v-2.5z")
                        .px-4.py-6.bg-white.rounded-r-lg.flex.justify-between.items-center.w-full.border.border-l-transparent.border-cute_purple-100
                            p.bg-white.text-black.uppercase.text-xs.text-center.p-2.mb-1.font-bold= error.msg
                            button(
                                class="close-alert transition duration-150 hover:scale-110"
                                data-alert-id=index
                            )
                                svg(xmlns="http://www.w3.org/2000/svg" class="fill-current text-black" viewBox="0 0 16 16" width="20" height="20")
                                    path(fill-rule="evenodd" d="M3.72 3.72a.75.75 0 011.06 0L8 6.94l3.22-3.22a.75.75 0 111.06 1.06L9.06 8l3.22 3.22a.75.75 0 11-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 01-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 010-1.06z")

        div(class="mt-8 mx-auto max-w-md")
            div(class="bg-white py-8 px-6 shadow-lg rounded-lg border-t-4 border-cute_purple-100")
                form(
                    class="space-y-6"
                    method="POST"
                    action="/auth/registro"
                    noValidate
                )
                    input(type="hidden" name="_csrf" value= csrfToken)
                    input(type="hidden" name="imagen" id="imagen-valor")

                    div(class="space-y-2")
                        label(
                            class="block text-sm uppercase text-cute_purple-100 font-bold font-mono"
                            for="nombre"
                        ) Nombre Completo
                        input(
                            class="w-full px-4 py-2 border border-cute_purple-100 rounded-lg font-mono placeholder-gray-400 focus:border-cute_purple-200 focus:ring-2 focus:ring-cute_purple-100 focus:ring-opacity-20 transition-colors outline-none"
                            id="nombre"
                            placeholder="Escribe tu nombre"
                            type="text"
                            name="nombre"
                            value= usuario ? usuario.nombre : ''
                        )

                    div(class="space-y-2")
                        label(
                            class="block text-sm uppercase text-cute_purple-100 font-bold font-mono"
                            for="email"
                        ) Correo Electrónico
                        input(
                            class="w-full px-4 py-2 border border-cute_purple-100 rounded-lg font-mono placeholder-gray-400 focus:border-cute_purple-200 focus:ring-2 focus:ring-cute_purple-100 focus:ring-opacity-20 transition-colors outline-none"
                            id="email"
                            placeholder="usuario@dominio.com"
                            type="email"
                            name="email"
                            value= usuario ? usuario.email : ''
                        )

                    div(class="space-y-2")
                        label(
                            class="block text-sm uppercase text-cute_purple-100 font-bold font-mono"
                            for="fechaNacimiento"
                        ) Fecha de Nacimiento
                        input(
                            class="w-full px-4 py-2 border border-cute_purple-100 rounded-lg font-mono focus:border-cute_purple-200 focus:ring-2 focus:ring-cute_purple-100 focus:ring-opacity-20 transition-colors outline-none"
                            id="fechaNacimiento"
                            type="date"
                            name="fechaNacimiento"
                            value= usuario ? usuario.fechaNacimiento : ''
                        )

                    div(class="space-y-2")
                        label(
                            class="block text-sm uppercase text-cute_purple-100 font-bold font-mono"
                            for="password"
                        ) Contraseña
                        input(
                            class="w-full px-4 py-2 border border-cute_purple-100 rounded-lg font-mono placeholder-gray-400 focus:border-cute_purple-200 focus:ring-2 focus:ring-cute_purple-100 focus:ring-opacity-20 transition-colors outline-none"
                            id="password"
                            placeholder="Mínimo 6 caracteres"
                            type="password"
                            name="password"
                        )

                    div(class="space-y-2")
                        label(
                            class="block text-sm uppercase text-cute_purple-100 font-bold font-mono"
                            for="repetir_password"
                        ) Confirmación de Contraseña
                        input(
                            class="w-full px-4 py-2 border border-cute_purple-100 rounded-lg font-mono placeholder-gray-400 focus:border-cute_purple-200 focus:ring-2 focus:ring-cute_purple-100 focus:ring-opacity-20 transition-colors outline-none"
                            id="repetir_password"
                            placeholder="Repite tu contraseña"
                            type="password"
                            name="repetir_password"
                        )

                    div(class="space-y-2")
                        label(
                            class="block text-sm uppercase text-cute_purple-100 font-bold font-mono"
                            for="imagen"
                        ) Foto de Perfil
                        div#imagen(class="dropzone w-full rounded-lg")
                            div(class="dz-message needsclick text-center")
                                div(class="mb-3")
                                    svg(
                                        class="mx-auto h-12 w-12 text-cute_purple-100"
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    )
                                        path(
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                                        )
                                p(class="text-cute_purple-100 font-medium font-mono") Sube o arrastra tu foto
                                p(class="text-sm text-gray-500 mt-1 font-mono") PNG, JPG, JPEG (máx. 5MB)

                    div(class="flex items-center justify-between mt-6")
                        a(
                            class="text-cute_purple-100 text-xs font-mono hover:text-cute_purple-200 transition-colors"
                            href="/auth/login"
                        ) ¿Ya tienes cuenta? Inicia Sesión
                        a(
                            class="text-cute_purple-100 text-xs font-mono hover:text-cute_purple-200 transition-colors"
                            href="/auth/olvide-password"
                        ) Olvidé mi contraseña

                    input(
                        class="w-full bg-cute_purple-100 hover:bg-cute_purple-200 text-white font-bold font-mono py-3 rounded-lg cursor-pointer transition-colors mt-6"
                        type="submit"
                        value="Crear cuenta"
                    )

block scripts
    script(src="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/dropzone.min.js")
    script.
        const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
        Dropzone.autoDiscover = false;

        document.addEventListener('DOMContentLoaded', function() {
            const myDropzone = new Dropzone("#imagen", {
                url: '/auth/subir-imagen-perfil',
                method: 'POST',
                paramName: 'file',
                maxFilesize: 5,
                maxFiles: 1,
                acceptedFiles: '.png,.jpg,.jpeg',
                addRemoveLinks: true,
                dictDefaultMessage: 'Sube o arrastra tu foto',
                dictRemoveFile: 'Borrar Archivo',
                headers: {
                    'CSRF-Token': csrfToken
                },
                init: function() {
                    console.log('Dropzone iniciado');
                    this.on('success', function(file, response) {
                        console.log('Archivo subido:', response);
                        document.querySelector('#imagen-valor').value = response.imagen;
                    });
                    
                    this.on('error', function(file, errorMessage) {
                        console.error('Error:', errorMessage);
                    });
                    
                    this.on('addedfile', function(file) {
                        console.log('Archivo agregado:', file.name);
                    });
                }
            });
        });


